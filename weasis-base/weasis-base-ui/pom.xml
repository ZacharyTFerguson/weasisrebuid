<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.weasis.base</groupId>
    <artifactId>weasis-base-parent</artifactId>
    <version>${revision}${changelist}</version>
    <relativePath>../weasis-base-parent/pom.xml</relativePath>
  </parent>

  <artifactId>weasis-base-ui</artifactId>
  <name>Weasis base UI</name>
  <description>UI aggregator named by weasis.main.ui. Docking layout model (not persisted).</description>

  <dependencies>
    <dependency>
      <groupId>com.miglayout</groupId>
      <artifactId>miglayout-swing</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.miglayout</groupId>
      <artifactId>miglayout-core</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
        <configuration>
          <bnd><![CDATA[
Bundle-SymbolicName: org.weasis.base.ui
Bundle-Name: Weasis Base UI
Bundle-Activator: org.weasis.base.ui.internal.MainWindowActivator
-dsannotations: *
Export-Package: !org.weasis.base.ui.internal.*, org.weasis.base.ui.*
Import-Package: org.osgi.framework,org.osgi.service.component,javax.swing,javax.swing.border,javax.swing.event,*
]]></bnd>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
