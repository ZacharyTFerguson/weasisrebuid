<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.weasis</groupId>
    <artifactId>weasis-parent</artifactId>
    <version>${revision}${changelist}</version>
    <relativePath>../weasis-parent/pom.xml</relativePath>
  </parent>

  <artifactId>weasis-distributions</artifactId>
  <packaging>pom</packaging>
  <name>Weasis distributions</name>
  <description>Second Maven invocation. Shipping prefs live in etc/config/base.json (MX-03). Native zip is WP-14.</description>

  <dependencies>
    <dependency>
      <groupId>org.weasis</groupId>
      <artifactId>weasis-launcher</artifactId>
      <version>${revision}${changelist}</version>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <id>compressXZ</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-enforcer-plugin</artifactId>
            <executions>
              <execution>
                <id>wp-14-shipping-json</id>
                <phase>package</phase>
                <goals>
                  <goal>enforce</goal>
                </goals>
                <configuration>
                  <rules>
                    <requireFilesExist>
                      <files>
                        <file>${project.basedir}/etc/config/base.json</file>
                      </files>
                    </requireFilesExist>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>weasis-native-zip</id>
                <phase>package</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>org.weasis.launcher.NativeDistribution</mainClass>
                  <arguments>
                    <argument>--out</argument>
                    <argument>${project.build.directory}/weasis-native.zip</argument>
                    <argument>--launcher</argument>
                    <argument>${settings.localRepository}/org/weasis/weasis-launcher/${app.version}/weasis-launcher-${app.version}.jar</argument>
                    <argument>--etc</argument>
                    <argument>${project.basedir}/etc/config</argument>
                    <argument>--bin</argument>
                    <argument>${project.basedir}/bin</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
